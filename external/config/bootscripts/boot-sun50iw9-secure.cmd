# DO NOT EDIT THIS FILE
#
# Secure boot script for Orange Pi Zero3 with encrypted root filesystem
# Please edit /boot/orangepiEnv.txt to set supported parameters
#

# default values
setenv load_addr "0x45000000"
setenv rootdev "/dev/mapper/cryptroot"
setenv plaindev "/dev/mmcblk0p2"
setenv bootdev "/dev/mmcblk0p1"
setenv verbosity "1"
setenv rootfstype "ext4"
setenv console "both"
setenv docker_optimizations "off"
setenv bootlogo "false"
setenv debug_uart "ttyS0"

# Security and tamper detection
setenv tamper_detection "on"
setenv secure_boot "on"

# Print boot source
itest.b *0x10028 == 0x00 && echo "U-boot loaded from SD"
itest.b *0x10028 == 0x02 && echo "U-boot loaded from eMMC or secondary SD"
itest.b *0x10028 == 0x03 && echo "U-boot loaded from SPI"

echo "Secure boot script loaded from ${devtype}"

# Load environment
if test -e ${devtype} ${devnum} ${prefix}orangepiEnv.txt; then
	load ${devtype} ${devnum} ${load_addr} ${prefix}orangepiEnv.txt
	env import -t ${load_addr} ${filesize}
fi

# Console setup
if test "${console}" = "display" || test "${console}" = "both"; then setenv consoleargs "console=${debug_uart},115200 console=tty1"; fi
if test "${console}" = "serial"; then setenv consoleargs "console=${debug_uart},115200"; fi
if test "${bootlogo}" = "true"; then setenv consoleargs "bootsplash.bootfile=bootsplash.orangepi ${consoleargs}"; fi

# get PARTUUID of first partition on SD/eMMC it was loaded from
if test "${devtype}" = "mmc"; then part uuid mmc 0:1 partuuid; fi

# Tamper detection check
if test "${tamper_detection}" = "on"; then
    echo "Performing tamper detection checks..."
    # Check if expected partitions exist
    if test ! -e ${devtype} ${devnum} 1; then
        echo "ERROR: Boot partition missing - possible tamper detected"
        # Could implement fallback or halt here
    fi
    if test ! -e ${devtype} ${devnum} 2; then
        echo "ERROR: Root partition missing - possible tamper detected" 
        # Could implement fallback or halt here
    fi
fi

# Set boot arguments for encrypted root
setenv bootargs "root=${rootdev} rootwait rootfstype=${rootfstype} cryptoroot=${plaindev} cryptokeyfile=/boot/keyfile ${consoleargs} consoleblank=0 loglevel=${verbosity} ubootpart=${partuuid} disp_reserve=${disp_reserve} rd.luks.uuid=auto rd.luks.allow-discards ${extraargs} ${extraboardargs}"

if test "${docker_optimizations}" = "on"; then setenv bootargs "${bootargs} cgroup_enable=memory swapaccount=1"; fi

# Display configuration
fdt set disp boot_fb0 ${boot_fb0}
fdt set disp boot_disp <${boot_disp}>
fdt set disp boot_disp1 <${boot_disp1}>
fdt set disp boot_disp2 <${boot_disp2}>
fdt set disp tv_vdid <${tv_vdid}>

fdt set disp fb0_width <${fb0_width}>
fdt set disp fb0_height <${fb0_height}>

fdt set mmc0 cap-sd-highspeed

# Apply user overlays
for overlay_file in ${user_overlays}; do
        if load ${devtype} ${devnum} ${load_addr} ${prefix}overlay-user/${overlay_file}.dtbo; then
                echo "Applying user provided DT overlay ${overlay_file}.dtbo"
                fdt apply ${load_addr} || setenv overlay_error "true"
        fi
done

# Load kernel and initrd (initrd contains cryptsetup for LUKS)
load ${devtype} ${devnum} ${ramdisk_addr_r} ${prefix}uInitrd
load ${devtype} ${devnum} ${kernel_addr_r} ${prefix}uImage

echo "Starting secure boot with encrypted root filesystem..."
bootm ${kernel_addr_r} ${ramdisk_addr_r} ${fdt_addr_r}

# Recompile with:
# mkimage -C none -A arm -T script -d /boot/boot.cmd /boot/boot.scr